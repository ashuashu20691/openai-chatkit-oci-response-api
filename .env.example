# OCI IAM user-principal authentication via an existing OCI config file/profile.
OCI_REGION=us-chicago-1
OCI_CONFIG_FILE=~/.oci/config
OCI_PROFILE_NAME=DEFAULT

# OCI Generative AI project OCID and model ID available in OCI_REGION.
OCI_PROJECT_OCID=
OCI_MODEL_ID=google.gemini-2.5-flash

# Local ChatKit server and Streamlit locations. Change these together if you change ports.
CHATKIT_UI_URL=http://127.0.0.1:8001/ui
CHATKIT_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,null
